# ============================================
# Hermes VPS Cluster - Worker Environment Template
# Copy this to ~/.hermes/.env on each worker VPS
# ============================================

# Enable API Server for inter-bot communication
API_SERVER_ENABLED=true

# API Server port (default: 8642)
API_SERVER_PORT=8642

# Bind address (0.0.0.0 = listen on all interfaces)
API_SERVER_HOST=0.0.0.0

# API Key for authentication (REQUIRED - generate with: openssl rand -hex 32)
API_SERVER_KEY=YOUR_API_KEY_HERE

# ============================================
# Optional: Additional Hermes config
# ============================================

# Model provider (uncomment and set if not already configured)
# OPENAI_API_KEY=sk-your-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here

# Nous Portal (optional - for bundled tools)
# NOUS_PORTAL_KEY=your-portal-key
